{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["npm", "pip_requirements", "github-actions"],
  "ignorePaths": [],
  "timezone": "America/Chicago",
  "schedule": ["* 0-5 * * 1"],
  "prCreation": "immediate",
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "internalChecksAsSuccess": false,
  "ignoreScripts": true,
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "groupName": "reviewed patch dependencies"
    },
    {
      "matchUpdateTypes": ["minor"],
      "groupName": "reviewed minor dependencies"
    },
    {
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "groupName": "reviewed dependency pins"
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "groupName": "development patch dependencies",
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "automerge": false
  }
}
