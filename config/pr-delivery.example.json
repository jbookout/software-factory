{
  "repos": {
    "jbookout/carr-system": {
      "checkout": "/absolute/path/to/carr-system",
      "worktreeRoot": "/absolute/path/to/delivery-worktrees",
      "requiredChecks": [
        {
          "name": "test",
          "appId": 15368
        }
      ],
      "checks": [
        [
          "ops/ci.sh",
          "--strict"
        ]
      ],
      "checkTimeoutMs": 3600000,
      "trustedReviewers": [
        "replace-with-verified-review-poster"
      ],
      "reviewPolicy": {
        "repositoryPath": "ops/config/review-tiers.v1.json"
      }
    },
    "jbookout/doctorcre-app": {
      "checkout": "/absolute/path/to/doctorcre-app",
      "worktreeRoot": "/absolute/path/to/delivery-worktrees",
      "requiredChecks": [
        {
          "name": "test",
          "appId": 15368
        }
      ],
      "checks": [
        [
          "npm",
          "test"
        ],
        [
          "python3",
          "capabilities/jev-browser-select/test_select.py"
        ]
      ],
      "checkTimeoutMs": 3600000,
      "trustedReviewers": [
        "replace-with-verified-review-poster"
      ],
      "reviewPolicy": {
        "file": "/absolute/path/to/software-factory/config/review-tiers/doctorcre-app.v1.json"
      }
    },
    "jbookout/software-factory": {
      "checkout": "/absolute/path/to/software-factory",
      "worktreeRoot": "/absolute/path/to/delivery-worktrees",
      "requiredChecks": [
        {
          "name": "test",
          "appId": 15368
        }
      ],
      "checks": [
        [
          "npm",
          "run",
          "check"
        ]
      ],
      "checkTimeoutMs": 3600000,
      "trustedReviewers": [
        "replace-with-verified-review-poster"
      ],
      "reviewPolicy": {
        "file": "/absolute/path/to/software-factory/config/review-tiers/software-factory.v1.json"
      }
    }
  },
  "stateDir": "state",
  "limits": {
    "runsPer24h": 8,
    "slots": 4,
    "timeoutMs": 4500000
  },
  "commandTimeoutMs": 120000,
  "checksTimeoutMs": 3600000,
  "pollMs": 60000,
  "autoPollMs": 300000,
  "retryMs": 120000,
  "queueRunsPer24h": 4,
  "github": {
    "requestsPerHour": 1000,
    "cacheMs": 60000
  },
  "queueTimeoutMs": 900000,
  "apiTimeoutMs": 120000,
  "attemptTimeoutMs": 9600000,
  "resources": {
    "capacity": 8,
    "agentUnits": 1,
    "browserConcurrency": 1
  },
  "holdsFile": "/absolute/path/to/orchestrator/merge-holds.txt",
  "orchestratorDir": "/absolute/path/to/orchestrator",
  "statusFile": "/absolute/path/to/orchestrator/delivery-status.txt",
  "cloudSlots": 1,
  "claude": {
    "command": "claude"
  }
}
