{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python3 *)"
    ],
    "deny": [
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(ps *eww*)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push * --force*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)"
    ]
  }
}
