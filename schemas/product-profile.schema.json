{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jbookout/software-factory/schemas/product-profile.schema.json",
  "title": "Product-owned software factory adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["commands"],
  "properties": {
    "root": { "type": "string" },
    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 100000000 },
    "modelRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "baseline", "candidates", "contracts"],
      "properties": {
        "enabled": { "const": true },
        "baseline": { "$ref": "#/$defs/route" },
        "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } },
        "optionalContext": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/pinnedReference" } },
        "contracts": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/pinnedReference" } }
      }
    },
    "commands": {
      "type": "object",
      "propertyNames": { "not": { "enum": ["deploy", "rollback"] } },
      "additionalProperties": { "oneOf": [
        { "$ref": "#/$defs/argv" },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/argv" } }
      ] }
    }
  },
  "$defs": {
    "pinnedReference": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "sourceRevision", "path", "startLine", "endLine"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "route": { "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "effort"],
      "properties": { "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": "string", "minLength": 1 } } }
  }
}
