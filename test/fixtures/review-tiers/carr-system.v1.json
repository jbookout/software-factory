{
  "schema_version": "review-tiers.v1",
  "purpose": "The one path-to-review-tier map: the source-merge controller, the Stop-hook review triage, the council security lens and the Jev code partition's noise filter all read it, so the four can no longer disagree.",
  "provenance": "engineering-workflow-sop section 15 'Risk tier by path: the decision procedure'; open loop 677; Joe 2026-09-30 exempted this build from the September 8 moratorium. Consolidates the four lists as of commit 3d6aa244 without removing any path they covered (ops/fixtures/review-tiers/pre-change-baseline.v1.json).",
  "semantics": {
    "path": "Repo-relative, forward slashes; a leading './' is dropped and backslashes become '/'. A missing or empty path is tier 3.",
    "tier": "tier(path) is the highest tier of every matching rule, else default_tier. tier(change set) is the highest tier of its paths. Rule order is presentation only.",
    "match": "path = exact equality; prefix = starts with; suffix = ends with; basename = the last path segment equals; contains = substring. case_insensitive lower-cases both sides first. No glob engine, so Python and JS evaluate identically.",
    "noise": "A path is review noise when a noise_exclusions row matches and no never_exclude row matches. Noise is dropped before a model reads a diff; it never lowers a tier.",
    "consumers": "Tier 3 never adds a required reviewer or a GitHub rule: the merge controller declines to AUTO-merge and a human presses merge (decision 8daefaba, advisory code-owner review). Thresholds live in the readers: merge refusal and triage high floor at tier 3, security lens at tier 2.",
    "tunable_scalars": "Dispatch alone may use bounded validation when every changed value is a named integer field within its approved range in both revisions. Added/removed fields, file modes, invalid JSON, changes to the policy, or values above the range keep path-based review. The Jev cap range limits spend without changing caller permissions or actions. Receipts bind base, head, diff digest and policy revision; required hosted CI and the path-based merge/security controls still apply."
  },
  "default_tier": 1,
  "tunable_scalars": [
    {"path": "ops/config/jev-cost-guard.v1.json", "field": "daily_paid_call_cap", "minimum": 0, "maximum": 3000}
  ],
  "rules": [
    {"id": "hooks", "tier": 3, "class": "protected", "match": "prefix", "pattern": "hooks/", "why": "Gate scripts that enforce write policy (doctrine tier 3 protected)."},
    {"id": "ops", "tier": 3, "class": "protected", "match": "prefix", "pattern": "ops/", "why": "Covers ops/config/ and ops/githooks/ (doctrine) and every ops script, which the merge controller already protected."},
    {"id": "github-workflows", "tier": 3, "class": "protected", "match": "prefix", "pattern": ".github/workflows/", "why": "CI and controller workflows."},
    {"id": "github-actions", "tier": 3, "class": "protected", "match": "prefix", "pattern": ".github/actions/", "why": "Composite actions the workflows run."},
    {"id": "codeowners", "tier": 3, "class": "protected", "match": "path", "pattern": ".github/CODEOWNERS", "why": "Review routing; kept ownerless by decision 8daefaba."},
    {"id": "claude-settings", "tier": 3, "class": "protected", "match": "prefix", "pattern": ".claude/settings", "why": "Settings file: permissions and hook wiring."},
    {"id": "claude-tree-settings", "tier": 3, "class": "protected", "match": "prefix", "pattern": "claude-tree/settings/", "why": "Settings files installed onto partner machines."},
    {"id": "claude-md", "tier": 3, "class": "protected", "match": "basename", "pattern": "CLAUDE.md", "why": "Session instructions at any depth."},
    {"id": "agents-md", "tier": 3, "class": "protected", "match": "basename", "pattern": "AGENTS.md", "why": "Agent instructions at any depth."},
    {"id": "tools-js", "tier": 3, "class": "protected", "match": "path", "pattern": "mcp-server/src/tools.js", "why": "The verb registry."},
    {"id": "sealed-engineering-runtime", "tier": 3, "class": "protected", "match": "path", "pattern": "mcp-server/src/engineering-runtime.js", "why": "Sealed entrypoint: engineering authority runtime."},
    {"id": "sealed-mcp", "tier": 3, "class": "protected", "match": "path", "pattern": "mcp-server/src/mcp.js", "why": "Sealed entrypoint: MCP dispatcher."},
    {"id": "sealed-sha256", "tier": 3, "class": "protected", "match": "path", "pattern": "mcp-server/src/sha256.js", "why": "Sealed entrypoint: digest primitive every seal relies on."},
    {"id": "sealed-source-merge-policy", "tier": 3, "class": "protected", "match": "path", "pattern": "mcp-server/src/source-merge-policy.js", "why": "Sealed entrypoint: the merge controller itself."},
    {"id": "sealed-work-request-intake", "tier": 3, "class": "protected", "match": "path", "pattern": "mcp-server/src/work-request-intake.js", "why": "Sealed entrypoint: Work Request intake."},
    {"id": "sealed-mutation-registry", "tier": 3, "class": "protected", "match": "path", "pattern": "mcp-server/src/mutation-registry.js", "why": "Sealed entrypoint: selects the SCAC registry the server enforces."},
    {"id": "sealed-run-source-merge", "tier": 3, "class": "protected", "match": "path", "pattern": "mcp-server/bin/run-source-merge.mjs", "why": "Sealed entrypoint: the merge controller's runner."},
    {"id": "review-tier-reader-js", "tier": 3, "class": "protected", "match": "prefix", "pattern": "mcp-server/src/review-tiers.", "why": "This map's generated Worker module and its reader."},
    {"id": "review-tier-reader-py", "tier": 3, "class": "protected", "match": "path", "pattern": "lib/review_tiers.py", "why": "This map's Python reader."},
    {"id": "toolchain-nvmrc", "tier": 3, "class": "protected", "match": "path", "pattern": ".nvmrc", "why": "Toolchain pin."},
    {"id": "deps-requirements-txt", "tier": 3, "class": "protected", "match": "path", "pattern": "requirements.txt", "why": "Python dependency manifest."},
    {"id": "deps-requirements-lock", "tier": 3, "class": "protected", "match": "path", "pattern": "requirements.lock", "why": "Python dependency lock."},
    {"id": "deps-mcp-package", "tier": 3, "class": "protected", "match": "path", "pattern": "mcp-server/package.json", "why": "Worker dependency manifest."},
    {"id": "deps-mcp-lock", "tier": 3, "class": "protected", "match": "path", "pattern": "mcp-server/package-lock.json", "why": "Worker dependency lock."},
    {"id": "deps-control-room-package", "tier": 3, "class": "protected", "match": "path", "pattern": "control-room/package.json", "why": "Control room dependency manifest."},
    {"id": "deps-workspace-package", "tier": 3, "class": "protected", "match": "path", "pattern": "workspace/package.json", "why": "Workspace dependency manifest."},
    {"id": "db-schema", "tier": 3, "class": "security_sensitive", "match": "path", "pattern": "db/schema.sql", "why": "Schema and grants snapshot."},
    {"id": "migrations", "tier": 3, "class": "security_sensitive", "match": "prefix", "pattern": "migrations/", "why": "Migrations carry grants."},
    {"id": "migrate-runner", "tier": 3, "class": "security_sensitive", "match": "path", "pattern": "tools/migrate.py", "why": "Applies migrations."},
    {"id": "worker-routes", "tier": 3, "class": "security_sensitive", "match": "path", "pattern": "mcp-server/src/index.js", "why": "Worker routes and auth doors."},
    {"id": "worker-deploy-config", "tier": 3, "class": "security_sensitive", "match": "path", "pattern": "mcp-server/wrangler.toml", "why": "Worker routes, domains and bindings."},
    {"id": "identity", "tier": 3, "class": "security_sensitive", "match": "path", "pattern": "mcp-server/src/identity.js", "why": "Tenant and partner isolation."},
    {"id": "session-identity", "tier": 3, "class": "security_sensitive", "match": "path", "pattern": "mcp-server/src/session-identity.js", "why": "Tenant and partner isolation."},
    {"id": "partner-authority", "tier": 3, "class": "security_sensitive", "match": "path", "pattern": "mcp-server/src/partner-authority.js", "why": "Partner authorization."},
    {"id": "unattended-guard", "tier": 3, "class": "security_sensitive", "match": "path", "pattern": "hooks/guard-unattended.py", "why": "The unattended guard (also under hooks/)."},
    {"id": "name-auth", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "auth", "case_insensitive": true, "why": "Authentication and authorization by name; carried from the review triage floor."},
    {"id": "name-security", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "security", "case_insensitive": true, "why": "Carried from the review triage floor."},
    {"id": "name-migrat", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "migrat", "case_insensitive": true, "why": "Migration tooling by name; carried from the review triage floor."},
    {"id": "name-db-dir", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "db/", "case_insensitive": true, "why": "Database directories; carried from the review triage floor."},
    {"id": "name-payment", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "payment", "case_insensitive": true, "why": "Money paths; carried from the review triage floor."},
    {"id": "name-crypto", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "crypto", "case_insensitive": true, "why": "Carried from the review triage floor."},
    {"id": "name-secret", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "secret", "case_insensitive": true, "why": "Credential handling; carried from the review triage floor."},
    {"id": "name-credential", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "credential", "case_insensitive": true, "why": "Credential handling (doctrine tier 3)."},
    {"id": "name-tenant", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "tenant", "case_insensitive": true, "why": "Tenant isolation (doctrine tier 3)."},
    {"id": "name-outbound", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "outbound", "case_insensitive": true, "why": "Outbound send paths (doctrine tier 3). No dedicated send module exists today: drafts only."},
    {"id": "name-egress", "tier": 3, "class": "security_sensitive", "match": "contains", "pattern": "egress", "case_insensitive": true, "why": "Outbound network and send guards."},
    {"id": "worker-source", "tier": 2, "class": "adversarial", "match": "prefix", "pattern": "mcp-server/src/", "why": "Verb contracts and public renders; carried from the council security lens."},
    {"id": "operator-entrypoints", "tier": 2, "class": "adversarial", "match": "prefix", "pattern": "bin/", "why": "Deploy, migrate and unattended runners; carried from the council security lens."},
    {"id": "model-room-routing", "tier": 2, "class": "adversarial", "match": "prefix", "pattern": "tools/room-bridge/", "why": "Model Room routing."},
    {"id": "control-room-contracts", "tier": 2, "class": "adversarial", "match": "prefix", "pattern": "control-room/contracts/", "why": "Schemas and contracts."},
    {"id": "workspace-contracts", "tier": 2, "class": "adversarial", "match": "prefix", "pattern": "workspace/contracts/", "why": "Schemas and contracts."},
    {"id": "json-schemas", "tier": 2, "class": "adversarial", "match": "suffix", "pattern": ".schema.json", "why": "Schemas anywhere."},
    {"id": "deal-room", "tier": 2, "class": "adversarial", "match": "prefix", "pattern": "dealroom/", "why": "Client-facing Deal Room."},
    {"id": "fill-engine", "tier": 2, "class": "adversarial", "match": "prefix", "pattern": "fill-engine/", "why": "Client-facing document fill."}
  ],
  "noise_exclusions": [
    {"id": "node-modules", "match": "contains", "pattern": "node_modules/", "why": "Installed dependencies."},
    {"id": "vendored", "match": "contains", "pattern": "/vendor/", "why": "Vendored code."},
    {"id": "minified", "match": "contains", "pattern": ".min.js", "why": "Minified assets."},
    {"id": "generated-registry", "match": "suffix", "pattern": ".generated.js", "why": "Generated registries and modules; their source is reviewed instead."},
    {"id": "lock-npm", "match": "basename", "pattern": "package-lock.json", "why": "Lockfile."},
    {"id": "lock-pip", "match": "basename", "pattern": "requirements.lock", "why": "Lockfile."},
    {"id": "lock-skills", "match": "basename", "pattern": "skills-lock.json", "why": "Lockfile."},
    {"id": "lock-yarn", "match": "basename", "pattern": "yarn.lock", "why": "Lockfile."},
    {"id": "lock-pnpm", "match": "basename", "pattern": "pnpm-lock.yaml", "why": "Lockfile."},
    {"id": "lock-uv", "match": "basename", "pattern": "uv.lock", "why": "Lockfile."}
  ],
  "never_exclude": [
    {"id": "migrations", "match": "prefix", "pattern": "migrations/", "why": "Migrations are never filtered (doctrine)."}
  ]
}
